# Required. Long random string; it's the only admin credential.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Public URL of the app (used for links in emails/webhooks and to mark the
# admin cookie Secure). No trailing slash.
BASE_URL=https://forms.example.com

# Bind address. Keep 127.0.0.1 when Caddy runs on the same host.
HOST=127.0.0.1
PORT=3000

# Storage (relative paths are resolved from the app folder).
DATA_DIR=data
UPLOAD_DIR=uploads

# Spam protection: max POSTs per IP per window on public forms.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MIN=15

# Email notifications (only used by forms with "Email me each response" on).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Optional. When set, webhook requests carry
# X-Formbuilder-Signature: sha256=<HMAC-SHA256 of the raw body>
WEBHOOK_SECRET=

# Which proxy hops to trust for the client IP (Express "trust proxy").
# "loopback" is right when Caddy runs on the same machine.
TRUST_PROXY=loopback
